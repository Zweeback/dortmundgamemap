    data = state.model_dump()
    for k, v in existing.items():
        if k not in data or data[k] is None:
            data[k] = v

    # Lease metadata on disk is authoritative because heartbeats/extensions may
    # advance it concurrently with the worker's local JobState object.
    if existing and existing.get("owner") == state.owner:
        for key in (
            "worker_type", "lease_id", "lease_generation", "lease_seconds",
            "lease_expires_at", "last_heartbeat_at", "max_active_state_seconds"
        ):
            if key in existing:
                data[key] = existing[key]

    data["current_state"] = state.state
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
    os.replace(tmp, path)


async def _lease_maintenance_loop(job_id: str, ctx: dict[str, Any]) -> None:
    while True:
        await asyncio.sleep(settings.heartbeat_interval_seconds)
        try:
            record, event = lease_manager.heartbeat(job_id, owner=ctx["owner"], lease_id=ctx["lease_id"])
            ctx.update(record)
            await _emit(event)

            expires = parse_utc(record.get("lease_expires_at"))
            if expires is None:
                raise LeaseError("lease expiry disappeared during heartbeat")
            remaining = (expires - utcnow_dt()).total_seconds()
            lease_seconds = int(record.get("lease_seconds") or settings.lease_seconds)
            if remaining <= max(settings.heartbeat_interval_seconds * 2, lease_seconds * 0.4):
                record, event = lease_manager.extend(job_id, owner=ctx["owner"], lease_id=ctx["lease_id"])
                ctx.update(record)
                await _emit(event)
        except asyncio.CancelledError:
            raise
        except LeaseError as exc:
            log.warning("Lease maintenance stopped for %s: %s", job_id, exc)
            return


async def _lease_sweeper_loop() -> None:
    while True:
        try:
            for event in lease_manager.sweep_once():
                await _emit(event)
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            log.exception("Lease sweeper failure: %s", exc)
        await asyncio.sleep(settings.sweeper_interval_seconds)


async def _verification_sweeper_loop() -> None:
    while True:
        try:
            events = await asyncio.to_thread(artifact_verifier.process_pending_once)
            for event in events:
                await _emit(event)
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            log.exception("Artifact verification sweeper failure: %s", exc)
        await asyncio.sleep(settings.verification_sweeper_interval_seconds)


async def _claim_and_verify_completion(
    job_id: str,
    *,
    owner: str,
    lease_id: str,
    contract_hash: str,
    artifacts: list[dict[str, Any]],
) -> dict[str, Any]:
    try:
        verifying, claimed_event = artifact_verifier.begin_completion_claim(
            job_id,
            owner=owner,
            lease_id=lease_id,
            contract_hash=contract_hash,
            artifacts=artifacts,
            lease_manager=lease_manager,
        )
    except (VerificationError, LeaseError, PermissionError) as exc:
        raise HTTPException(status_code=409, detail=str(exc)) from exc

    await _emit(claimed_event)
    verified, events = await asyncio.to_thread(artifact_verifier.verify_once, job_id)
    for event in events:
        await _emit(event)
    return verified


def load_capabilities() -> list[dict[str, Any]]:
    items = []
    for cap in registry.list_capabilities():
        items.append(cap.model_dump())
    return items


def _is_resource_defer_error(errors: List[str]) -> bool:
    return any("insufficient_vram" in err or "insufficient_ram" in err for err in errors)


async def _emit(event: dict[str, Any]) -> None:
    append_event(event)
    await bus.broadcast(event)


async def execute_admitted_job(
    cmd: BridgeCommand,
    job_id: str,
    sm: JobStateMachine,
    state: JobState,
    ctx: dict[str, Any],
) -> None:
    artifacts: List[str] = []
    errors: List[str] = []

    try:
        # Refuse to begin work with a stale lease.
        lease_manager.validate(job_id, owner=ctx["owner"], lease_id=ctx["lease_id"])
        if cmd.dry_run:
            await asyncio.sleep(0.05)
            artifacts_jobs_dir = JOBS_DIR / job_id
            artifacts_jobs_dir.mkdir(parents=True, exist_ok=True)

            if cmd.target == "blender":
                art_file = f"blender_job_{cmd.command_type.split('.')[-1]}_{cmd.payload.get('model_name', 'model')}.glb"
                marker = artifacts_jobs_dir / art_file
                marker.write_text(f"MOCK GLB DATA FOR ACTION {cmd.command_type}\n", encoding="utf-8")
            elif cmd.target == "meshroom":
                art_file = f"meshroom_reconstruction_{cmd.payload.get('project_id', 'proj')}.obj"
                marker = artifacts_jobs_dir / art_file
                marker.write_text(f"# MOCK OBJ RECONSTRUCTION FOR ACTION {cmd.command_type}\n", encoding="utf-8")
            else:
                marker = artifacts_jobs_dir / "dry_run.txt"
                marker.write_text("ok\n", encoding="utf-8")

            artifacts.append(f"artifacts/jobs/{job_id}/{marker.name}")
        else:
            loop = asyncio.get_running_loop()
            if cmd.target == "blender":
                action = cmd.command_type.split(".")[-1]
                result = await loop.run_in_executor(
                    None, lambda: run_blender_command(action=action, payload=cmd.payload)
                )
                if result.get("success"):
                    artifacts = result.get("artifacts", [])
                else:
                    errors.append(result.get("error", "Unknown Blender error"))
            elif cmd.target == "meshroom":
                action = cmd.command_type.split(".")[-1]
                result = await loop.run_in_executor(
                    None, lambda: run_meshroom_pipeline(action=action, payload=cmd.payload)
                )
                if result.get("success"):
                    artifacts = result.get("artifacts", [])
                else:
                    errors.append(result.get("error", "Unknown Meshroom error"))
            elif cmd.target == "unity":
                report_name = "unity_sync_report.json"
                report_path = JOBS_DIR / job_id / report_name
                report_path.parent.mkdir(parents=True, exist_ok=True)
                report_path.write_text('{"status": "success", "synced_assets_count": 0}\n', encoding="utf-8")
                artifacts.append(f"artifacts/jobs/{job_id}/{report_name}")
            else:
                errors.append(f"Unsupported target: {cmd.target}")
    except Exception as exc:
        errors.append(str(exc))

    input_files: list[str] = []
    if "images_dir" in cmd.payload:
        img_dir = cmd.payload["images_dir"]
        full_img_dir = Path(img_dir) if os.path.isabs(img_dir) else BASE_DIR / img_dir
        if full_img_dir.is_dir():
            try:
                for f in os.listdir(full_img_dir):
                    fpath = full_img_dir / f
                    if fpath.is_file():
                        input_files.append(str(Path(img_dir) / f).replace("\\", "/"))
            except Exception:
                pass
        else:
            input_files.append(img_dir)

    artifacts_str = [str(art).replace("\\", "/") for art in artifacts]
    generate_provenance(
        job_id=job_id,
        command={"command_type": cmd.command_type, "payload": cmd.payload},
        input_files=input_files,
        output_files=artifacts_str,
    )

    _sync_state_lease(state, ctx)
    if errors:
        state.error = "; ".join(errors)
        state.updated_at = utcnow()
        try:
            sm.transition_to(
                "failed",
                reason=state.error,
                owner=ctx["owner"],
                lease_id=ctx["lease_id"],
            )
            state.state = "failed"
            write_job_state(state)
            await _emit({"type": "job.failed", "job_id": job_id, "error": state.error})
        except (PermissionError, LeaseError) as exc:
            log.warning("Stale worker refused failed-state mutation for %s: %s", job_id, exc)
        return

    state.updated_at = utcnow()
    state.artifacts = artifacts_str
    write_job_state(state)

    # Workers can only claim completion. The verifier independently re-reads
    # artifact bytes and is the sole authority allowed to promote to succeeded.
    claims = artifact_verifier.make_claims(job_id, artifacts_str)
    contract_hash = state.expected_artifact_contract_hash or ""
    try:
        final_state = await _claim_and_verify_completion(
            job_id,
            owner=ctx["owner"],
            lease_id=ctx["lease_id"],
            contract_hash=contract_hash,
            artifacts=claims,
        )
        if final_state.get("current_state") != "succeeded":
            log.warning(
                "Completion verification rejected for %s: %s",
                job_id,
                final_state.get("verification_errors"),
            )
    except HTTPException as exc:
        log.warning("Completion claim rejected for %s: %s", job_id, exc.detail)


async def retry_deferred_entry(entry: dict[str, Any]) -> None:
    from orchestrator.deferred_queue import load_deferred_entry, save_deferred_entry, remove_deferred_entry
    from orchestrator.resource_manager import admit_job_with_recovery
    from orchestrator.retry_scheduler import mark_retry_scheduled, mark_retry_exhausted

    job_id = entry["job_id"]
    current = load_deferred_entry(job_id)
    if not current:
        return

    cmd = BridgeCommand(**current["command"])
    sm = JobStateMachine(job_id)
    if sm.state not in ("deferred", "orphaned"):
        remove_deferred_entry(job_id)
        return

    try:
        claimed, lease_event = lease_manager.claim(
            job_id,
            owner=LOCAL_OWNER,
            worker_type="gateway.retry",
            lease_seconds=settings.lease_seconds,
        )
    except LeaseError as exc:
        log.warning("Retry claim refused for %s: %s", job_id, exc)
        return
    await _emit(lease_event)
    ctx = dict(claimed)
    maintenance = asyncio.create_task(_lease_maintenance_loop(job_id, ctx))

    try:
        # LeaseManager.claim() atomically moves deferred/orphaned/failed jobs to
        # retrying, so the returned lease is immediately heartbeat-capable.
        state = load_job_state(job_id)
        _sync_state_lease(state, ctx)
        if state.state != "retrying":
            log.error("Retry claim did not enter retrying for %s: %s", job_id, state.state)
            current["dispatching"] = False
            save_deferred_entry(current)
            return

        state.updated_at = utcnow()
        write_job_state(state)
        await _emit({"type": "job.retrying", "job_id": job_id, "attempt": current["retry_count"] + 1})

        model_name = os.getenv("OLLAMA_RECOVERY_MODEL", "gemma4")
        admitted, reason, ollama_unloaded = await admit_job_with_recovery(
            cmd.target, cmd.command_type, model_name=model_name
        )
        if ollama_unloaded and admitted:
            await _emit({
                "type": "job.ollama_unloaded",
                "job_id": job_id,
                "detail": f"Unloaded {model_name} model to satisfy job VRAM requirements",
            })

        _sync_state_lease(state, ctx)
        if not admitted:
            if current["retry_count"] + 1 >= current.get("max_retries", 5):
                sm.transition_to(
                    "failed",
                    reason=f"retry_exhausted: {reason}",
                    owner=ctx["owner"],
                    lease_id=ctx["lease_id"],
                )
                state.state = "failed"
                state.error = f"retry_exhausted: {reason}"
                state.updated_at = utcnow()
                write_job_state(state)
                mark_retry_exhausted(current)
                await _emit({"type": "job.retry_exhausted", "job_id": job_id, "error": state.error})
                return

            sm.transition_to(
                "deferred",
                reason=reason,
                owner=ctx["owner"],
                lease_id=ctx["lease_id"],
