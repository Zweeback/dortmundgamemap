    except LeaseError as exc:
        raise HTTPException(status_code=409, detail=str(exc)) from exc
    await _emit(event)
    return {
        "job_id": job_id,
        "owner": record["owner"],
        "lease_id": record["lease_id"],
        "lease_generation": record["lease_generation"],
        "lease_expires_at": record["lease_expires_at"],
        "lease_token": _lease_token_for(record),
    }

@app.post("/api/bridge/jobs/{job_id}/completion-claim")
async def claim_completion(
    job_id: str,
    body: CompletionClaimRequest,
    x_lease_token: str = Header(..., alias="X-Lease-Token"),
) -> dict[str, Any]:
    _verify_presented_lease_token(job_id, body, x_lease_token)
    final_state = await _claim_and_verify_completion(
        job_id,
        owner=body.owner,
        lease_id=body.lease_id,
        contract_hash=body.contract_hash,
        artifacts=[item.model_dump() for item in body.artifacts],
    )
    return {
        "job_id": job_id,
        "state": final_state.get("current_state"),
        "verification_errors": final_state.get("verification_errors", []),
        "verification_completed_at": final_state.get("verification_completed_at"),
    }


@app.get("/jobs/{job_id}")
async def get_job(job_id: str) -> dict[str, Any]:
    path = JOBS_DIR / job_id / "job_state.json"
    if not path.exists():
        raise HTTPException(status_code=404, detail="job not found")
    data = json.loads(path.read_text(encoding="utf-8"))
    if "state" not in data and "current_state" in data:
        state = data["current_state"]
        if state == "succeeded":
            data["state"] = "completed"
        else:
            data["state"] = state
    return data

@app.websocket("/ws/events")
async def ws_events(ws: WebSocket) -> None:
    # This channel is explicitly best-effort in Patch 1. It is never the source
    # of truth for critical decisions; reconnecting clients must re-poll durable
    # job state (/jobs/{job_id}) and/or the persisted event log (/events).
    await ws.accept()
    await ws.send_json({
        "type": "stream.notice",
        "delivery": "best_effort",
        "recovery": "re-poll /jobs/{job_id} and /events after reconnect",
    })
    bus.clients.add(ws)
    try:
        while True:
            await ws.receive_text()  # keepalive from client
    except WebSocketDisconnect:
        bus.clients.discard(ws)

