        "target": cmd.target,
        "action": cmd.action,
    })
    return {
        "success": True,
        "command_id": cmd.command_id,
        "target": cmd.target,
        "action": cmd.action,
    }

def _legacy_capability_for(job_type: str, payload: dict[str, Any]) -> str:
    action = payload.get("action")
    if job_type == "render" or action == "render_scene":
        return "blender.render_scene"
    if job_type in {"photogrammetry", "meshroom"}:
        return "meshroom.photogrammetry_reconstruct"
    if job_type in {"unity", "sync"}:
        return "unity.sync_assets"
    return "blender.render_scene"

@app.post("/jobs")
async def legacy_create_job(
    job: LegacyJobRequest,
    x_bridge_token: str = Header(..., alias="X-Bridge-Token"),
) -> dict[str, Any]:
    _require_bridge_token(x_bridge_token)
    job_id = str(uuid.uuid4())
    capability_id = _legacy_capability_for(job.job_type, job.payload)
    state_path = JOBS_DIR / job_id / "job_state.json"
    provenance_rel = f"artifacts/jobs/{job_id}/provenance.json"
    now = utcnow()
    artifact_contract = artifact_verifier.build_contract(
        job_id=job_id,
        target="legacy",
        command_type=capability_id,
        constraints={},
    )
    queued = JobState(
        job_id=job_id,
        command_id=f"legacy_{uuid.uuid4().hex[:12]}",
        correlation_id=job_id,
        target="legacy",
        command_type=capability_id,
        state="queued",
        created_at=now,
        updated_at=now,
        dry_run=False,
        artifact_contract=artifact_contract,
        expected_artifact_contract_hash=artifact_verifier.contract_hash(artifact_contract),
    )
    claimed, lease_event = lease_manager.create_claimed(
        queued.model_dump(),
        owner=LOCAL_OWNER,
        worker_type="gateway.legacy",
        lease_seconds=settings.lease_seconds,
    )
    await _emit(lease_event)

    generate_provenance(
        job_id=job_id,
        command={"job_type": job.job_type, "payload": job.payload, "capability_id": capability_id},
        input_files=[],
        output_files=[],
    )
    await _emit({
        "type": "legacy.job.queued",
        "event": "CommandReceived",
        "job_id": job_id,
        "job_type": job.job_type,
        "capability_id": capability_id,
        "owner": claimed["owner"],
        "lease_id": claimed["lease_id"],
    })

    return {
        "job_id": job_id,
        "job_type": job.job_type,
        "capability_id": capability_id,
        "state": "queued",
        "status": "pending",
        "job_state_path": str(state_path).replace("\\", "/"),
        "provenance_path": provenance_rel,
    }

@app.get("/jobs")
async def legacy_list_jobs() -> list[dict[str, Any]]:
    jobs: list[dict[str, Any]] = []
    if not JOBS_DIR.exists():
        return jobs
    for state_file in JOBS_DIR.glob("*/job_state.json"):
        try:
            jobs.append(json.loads(state_file.read_text(encoding="utf-8")))
        except Exception:
            continue
    return jobs

@app.post("/api/bridge/command", status_code=202)
async def bridge_command(
    cmd: BridgeCommand,
    x_bridge_token: str = Header(..., alias="X-Bridge-Token"),
) -> dict[str, Any]:
    _require_bridge_token(x_bridge_token)
    job_id = cmd.job_id or f"job_{uuid.uuid4().hex[:12]}"
    now = utcnow()
    try:
        artifact_contract = artifact_verifier.build_contract(
            job_id=job_id,
            target=cmd.target,
            command_type=cmd.command_type,
            constraints=cmd.constraints,
        )
    except VerificationError as exc:
        raise HTTPException(status_code=400, detail=f"invalid artifact contract: {exc}") from exc

    accepted = JobState(
        job_id=job_id,
        command_id=cmd.command_id,
        correlation_id=cmd.mission_id or cmd.command_id,
        target=cmd.target,
        command_type=cmd.command_type,
        state="accepted",
        created_at=now,
        updated_at=now,
        dry_run=cmd.dry_run,
        artifact_contract=artifact_contract,
        expected_artifact_contract_hash=artifact_verifier.contract_hash(artifact_contract),
    )
    lease_seconds = int(cmd.constraints.get("lease_seconds", settings.lease_seconds))
    try:
        claimed, lease_event = lease_manager.create_claimed(
            accepted.model_dump(),
            owner=LOCAL_OWNER,
            worker_type="gateway.local",
            lease_seconds=lease_seconds,
        )
    except LeaseError as exc:
        raise HTTPException(status_code=409, detail=str(exc)) from exc

    await _emit(lease_event)
    generate_provenance(
        job_id=job_id,
        command={"command_type": cmd.command_type, "payload": cmd.payload},
        input_files=[],
        output_files=[],
    )

    await _emit({
        "type": "job.accepted",
        "job_id": job_id,
        "command_type": cmd.command_type,
        "owner": claimed["owner"],
        "lease_id": claimed["lease_id"],
        "lease_generation": claimed["lease_generation"],
    })

    asyncio.create_task(run_job(cmd, job_id, dict(claimed)))
    return {
        "accepted": True,
        "job_id": job_id,
        "command_id": cmd.command_id,
        "correlation_id": accepted.correlation_id,
        "lease_expires_at": claimed["lease_expires_at"],
        "expected_artifact_contract_hash": claimed.get("expected_artifact_contract_hash"),
    }


@app.post("/api/bridge/jobs/{job_id}/claim")
async def claim_job(
    job_id: str,
    body: LeaseClaimRequest,
    x_bridge_token: str = Header(..., alias="X-Bridge-Token"),
) -> dict[str, Any]:
    _require_bridge_token(x_bridge_token)
    try:
        claimed, event = lease_manager.claim(
            job_id,
            owner=body.owner,
            worker_type=body.worker_type,
            lease_seconds=body.lease_seconds,
        )
    except LeaseError as exc:
        raise HTTPException(status_code=409, detail=str(exc)) from exc
    await _emit(event)
    return {
        "job_id": job_id,
        "owner": claimed["owner"],
        "lease_id": claimed["lease_id"],
        "lease_generation": claimed["lease_generation"],
        "lease_expires_at": claimed["lease_expires_at"],
        "lease_token": _lease_token_for(claimed),
        "expected_artifact_contract_hash": claimed.get("expected_artifact_contract_hash"),
    }


@app.post("/api/bridge/jobs/{job_id}/heartbeat")
async def heartbeat_job(
    job_id: str,
    body: LeaseMutationRequest,
    x_lease_token: str = Header(..., alias="X-Lease-Token"),
) -> dict[str, Any]:
    _verify_presented_lease_token(job_id, body, x_lease_token)
    try:
        record, event = lease_manager.heartbeat(job_id, owner=body.owner, lease_id=body.lease_id)
    except LeaseError as exc:
        raise HTTPException(status_code=409, detail=str(exc)) from exc
    await _emit(event)
    return {
        "ok": True,
        "job_id": job_id,
        "last_heartbeat_at": record["last_heartbeat_at"],
        "lease_expires_at": record["lease_expires_at"],
    }


@app.post("/api/bridge/jobs/{job_id}/extend")
async def extend_job_lease(
    job_id: str,
    body: LeaseMutationRequest,
    x_lease_token: str = Header(..., alias="X-Lease-Token"),
) -> dict[str, Any]:
    _verify_presented_lease_token(job_id, body, x_lease_token)
