    record["state_entered_at"] = iso(now - timedelta(minutes=2))
    record["max_active_state_seconds"] = 10
    write(m, "j6", record)

    m.sweep_once()
    assert m.load("j6")["orphaned_reason"] == "state_ttl_exceeded"


def test_missing_lease_metadata_is_visible_failure(tmp_path: Path) -> None:
    m = manager(tmp_path, "A")
    write(m, "j7", base_job("j7", state="running"))

    events = m.sweep_once()
    record = m.load("j7")
    assert record["current_state"] == "orphaned"
    assert record["orphaned_reason"] == "missing_lease_metadata"
    assert any(e["type"] == "agent.orphaned" for e in events)


def test_expired_lease_blocks_worker_transition_before_sweeper(tmp_path: Path) -> None:
    m = manager(tmp_path, "A")
    record, _ = m.create_claimed(
        base_job("j8"), owner="worker:jules:8", worker_type="jules"
    )
    record["lease_expires_at"] = iso(datetime.now(timezone.utc) - timedelta(seconds=1))
    write(m, "j8", record)
    sm = JobStateMachine("j8", initial_state="accepted", jobs_root=m.jobs_dir)

    with pytest.raises(PermissionError, match="lease expired"):
        sm.transition_to(
            "validating",
            owner=record["owner"],
            lease_id=record["lease_id"],
        )



def test_process_lock_blocks_second_gateway_instance(tmp_path: Path) -> None:
    lock_path = tmp_path / "artifacts" / "gateway-process.lock"
    first = ProcessExclusiveLock(lock_path, holder="inst-A")
    second = ProcessExclusiveLock(lock_path, holder="inst-B")
    first.acquire()
    try:
        with pytest.raises(ProcessLockError, match="already held"):
            second.acquire()
    finally:
        first.release()

    # OS lock is released when the owner exits/releases, so cold-start takeover works.
    second.acquire()
    second.release()


def test_earliest_deadline_wins_even_when_lease_is_still_valid(tmp_path: Path) -> None:
    m = manager(tmp_path, "A", heartbeat=120, active=10)
    record, _ = m.create_claimed(
        base_job("j9"), owner="worker:jules:9", worker_type="jules"
    )
    now = datetime.now(timezone.utc)
    record["state_entered_at"] = iso(now - timedelta(seconds=30))
    record["max_active_state_seconds"] = 10
    record["last_heartbeat_at"] = iso(now)
    record["lease_expires_at"] = iso(now + timedelta(minutes=5))
    write(m, "j9", record)

    m.sweep_once()
    assert m.load("j9")["orphaned_reason"] == "state_ttl_exceeded"


def test_earliest_time_failure_is_reported_deterministically(tmp_path: Path) -> None:
    m = manager(tmp_path, "A", heartbeat=10, active=60)
    record, _ = m.create_claimed(
        base_job("j10"), owner="worker:copilot:10", worker_type="copilot"
    )
    now = datetime.now(timezone.utc)
    # Lease expired 5s ago; heartbeat deadline expired 20s ago; state TTL later.
    # Earliest violated deadline is heartbeat timeout, so reason is deterministic.
    record["lease_expires_at"] = iso(now - timedelta(seconds=5))
    record["last_heartbeat_at"] = iso(now - timedelta(seconds=30))
    record["state_entered_at"] = iso(now - timedelta(seconds=20))
    record["max_active_state_seconds"] = 60
    write(m, "j10", record)

    m.sweep_once()
    assert m.load("j10")["orphaned_reason"] == "heartbeat_timeout"


def test_stale_lease_cannot_mint_another_generation(tmp_path: Path) -> None:
    m = manager(tmp_path, "A")
    original, _ = m.create_claimed(
        base_job("j11"), owner="worker:gemini:11", worker_type="gemini"
    )
    extended, _ = m.extend(
        "j11", owner=original["owner"], lease_id=original["lease_id"]
    )
    assert extended["lease_generation"] == original["lease_generation"] + 1

    with pytest.raises(LeaseError, match="stale or foreign lease"):
        m.extend("j11", owner=original["owner"], lease_id=original["lease_id"])



def test_process_lock_is_cross_process_not_just_thread_local(tmp_path: Path) -> None:
    lock_path = tmp_path / "artifacts" / "gateway-process.lock"
    parent = ProcessExclusiveLock(lock_path, holder="parent")
    parent.acquire()
    try:
        ctx = mp.get_context("spawn")
        queue = ctx.Queue()
        child = ctx.Process(target=_child_process_lock_attempt, args=(str(lock_path), queue))
        child.start()
        child.join(timeout=5)
        assert child.exitcode == 0
        assert queue.get(timeout=1) == "blocked"
    finally:
        parent.release()


def test_main_wiring_uses_separate_lease_secret_and_continuous_sweeper() -> None:
    main_source = (Path(__file__).parents[1] / "orchestrator" / "main.py").read_text(encoding="utf-8")
    assert 'os.getenv("BRIDGE_TOKEN", "")' in main_source
    assert 'os.getenv("LEASE_HMAC_SECRET", "")' in main_source
    assert "token_secret=settings.lease_hmac_secret" in main_source
    assert "root_secret=settings.bridge_token" not in main_source
    assert "process_lock.acquire()" in main_source
    assert 'asyncio.create_task(_lease_sweeper_loop(), name="lease-sweeper")' in main_source
    assert '"delivery": "best_effort"' in main_source



def test_reclaim_from_orphaned_enters_retrying_with_valid_new_lease(tmp_path: Path) -> None:
    old = manager(tmp_path, "old")
    old.create_claimed(base_job("j12"), owner=old.local_owner, worker_type="gateway.local")
    restarted = manager(tmp_path, "new")
    restarted.sweep_once()
    assert restarted.load("j12")["current_state"] == "orphaned"

    reclaimed, event = restarted.claim(
        "j12", owner="worker:jules:12", worker_type="jules"
    )
    assert event["type"] == "lease.claimed"
    assert reclaimed["current_state"] == "retrying"
    validated = restarted.validate(
        "j12", owner=reclaimed["owner"], lease_id=reclaimed["lease_id"]
    )
    assert validated["current_state"] == "retrying"
