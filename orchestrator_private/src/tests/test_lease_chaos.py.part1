from __future__ import annotations

import json
import multiprocessing as mp
from datetime import datetime, timedelta, timezone
from pathlib import Path

import pytest

from orchestrator.lease_manager import LeaseConfig, LeaseError, LeaseManager
from orchestrator.process_lock import ProcessExclusiveLock, ProcessLockError
from orchestrator.state_machine import JobStateMachine


def _child_process_lock_attempt(lock_path: str, queue) -> None:
    lock = ProcessExclusiveLock(lock_path, holder="child")
    try:
        lock.acquire()
    except ProcessLockError:
        queue.put("blocked")
        return
    try:
        queue.put("acquired")
    finally:
        lock.release()


def iso(dt: datetime) -> str:
    return dt.isoformat().replace("+00:00", "Z")


def base_job(job_id: str, state: str = "accepted") -> dict:
    now = iso(datetime.now(timezone.utc))
    return {
        "job_id": job_id,
        "command_id": f"cmd_{job_id}",
        "correlation_id": f"corr_{job_id}",
        "target": "unity",
        "command_type": "unity.sync_assets",
        "state": state,
        "current_state": state,
        "created_at": now,
        "updated_at": now,
        "state_entered_at": now,
        "dry_run": True,
    }


def manager(tmp_path: Path, instance: str, **overrides) -> LeaseManager:
    config = LeaseConfig(
        default_lease_seconds=overrides.get("lease", 600),
        heartbeat_timeout_seconds=overrides.get("heartbeat", 120),
        max_active_state_seconds=overrides.get("active", 1800),
    )
    return LeaseManager(
        tmp_path / "jobs",
        token_secret="test-lease-hmac-secret",
        supervisor_instance_id=instance,
        config=config,
    )


def write(manager: LeaseManager, job_id: str, record: dict) -> None:
    path = manager.state_path(job_id)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(record, indent=2), encoding="utf-8")


def test_sweeper_is_only_orphan_authority(tmp_path: Path) -> None:
    m = manager(tmp_path, "A")
    record, _ = m.create_claimed(
        base_job("j1"), owner=m.local_owner, worker_type="gateway.local"
    )
    sm = JobStateMachine("j1", initial_state="accepted", jobs_root=m.jobs_dir)

    with pytest.raises(PermissionError, match="Only the lease sweeper"):
        sm.transition_to(
            "orphaned",
            reason="worker tried to self-orphan",
            owner=record["owner"],
            lease_id=record["lease_id"],
        )


def test_extension_rotates_lease_and_invalidates_stale_mutation(tmp_path: Path) -> None:
    m = manager(tmp_path, "A")
    record, _ = m.create_claimed(
        base_job("j2"), owner="worker:jules:1", worker_type="jules"
    )
    old_id = record["lease_id"]
    old_generation = record["lease_generation"]
    old_token = m.issue_lease_token(
        "j2", owner=record["owner"], lease_id=old_id, generation=old_generation
    )

    extended, event = m.extend("j2", owner=record["owner"], lease_id=old_id)
    assert event["type"] == "lease.extended"
    assert extended["lease_id"] != old_id
    assert extended["lease_generation"] == old_generation + 1

    with pytest.raises(LeaseError, match="stale or foreign lease"):
        m.validate("j2", owner=record["owner"], lease_id=old_id)

    assert not m.verify_lease_token(
        old_token,
        job_id="j2",
        owner=record["owner"],
        lease_id=old_id,
        generation=extended["lease_generation"],
    )
    new_token = m.issue_lease_token(
        "j2",
        owner=extended["owner"],
        lease_id=extended["lease_id"],
        generation=extended["lease_generation"],
    )
    assert m.verify_lease_token(
        new_token,
        job_id="j2",
        owner=extended["owner"],
        lease_id=extended["lease_id"],
        generation=extended["lease_generation"],
    )


def test_cold_restart_orphans_stale_process_owner_immediately(tmp_path: Path) -> None:
    old = manager(tmp_path, "old-process")
    old.create_claimed(
        base_job("j3"), owner=old.local_owner, worker_type="gateway.local"
    )

    restarted = manager(tmp_path, "new-process")
    events = restarted.sweep_once()
    record = restarted.load("j3")

    assert record["current_state"] == "orphaned"
    assert record["orphaned_reason"] == "stale_process_owner"
    assert record["previous_owner"] == old.local_owner
    assert any(e["type"] == "agent.orphaned" for e in events)
    orphan_event = next(e for e in events if e["type"] == "agent.orphaned")
    assert orphan_event["before"]["current_state"] == "accepted"
    assert orphan_event["after"]["current_state"] == "orphaned"


def test_expired_lease_emits_expiry_and_orphan_events(tmp_path: Path) -> None:
    m = manager(tmp_path, "A")
    record, _ = m.create_claimed(
        base_job("j4"), owner="worker:copilot:1", worker_type="copilot"
    )
    record["lease_expires_at"] = iso(datetime.now(timezone.utc) - timedelta(seconds=1))
    record["last_heartbeat_at"] = iso(datetime.now(timezone.utc))
    write(m, "j4", record)

    events = m.sweep_once()
    assert [e["type"] for e in events] == ["lease.expired", "agent.orphaned"]
    assert m.load("j4")["orphaned_reason"] == "lease_expired"


def test_heartbeat_timeout_cannot_quietly_wait(tmp_path: Path) -> None:
    m = manager(tmp_path, "A", heartbeat=5)
    record, _ = m.create_claimed(
        base_job("j5"), owner="worker:gemini:1", worker_type="gemini"
    )
    now = datetime.now(timezone.utc)
    record["last_heartbeat_at"] = iso(now - timedelta(seconds=30))
    record["lease_expires_at"] = iso(now + timedelta(minutes=5))
    write(m, "j5", record)

    m.sweep_once()
    assert m.load("j5")["orphaned_reason"] == "heartbeat_timeout"


def test_hard_active_state_ttl_is_enforced(tmp_path: Path) -> None:
    m = manager(tmp_path, "A", heartbeat=120, active=10)
    record, _ = m.create_claimed(
        base_job("j6"), owner="worker:grok:1", worker_type="grok"
    )
    now = datetime.now(timezone.utc)
    record["last_heartbeat_at"] = iso(now)
    record["lease_expires_at"] = iso(now + timedelta(minutes=5))
