from __future__ import annotations

import json
from datetime import datetime, timedelta, timezone
from pathlib import Path

import pytest

from orchestrator.artifact_verifier import ArtifactVerifier, VerificationConfig
from orchestrator.lease_manager import LeaseConfig, LeaseManager
from orchestrator.state_machine import JobStateMachine


def iso(dt: datetime) -> str:
    return dt.isoformat().replace("+00:00", "Z")


def setup_running_job(tmp_path: Path, job_id: str = "verify-1", ttl: int = 120):
    jobs_dir = tmp_path / "artifacts" / "jobs"
    lease_manager = LeaseManager(
        jobs_dir,
        token_secret="lease-secret",
        supervisor_instance_id="test",
        config=LeaseConfig(
            default_lease_seconds=600,
            heartbeat_timeout_seconds=120,
            max_active_state_seconds=1800,
        ),
    )
    verifier = ArtifactVerifier(
        tmp_path,
        jobs_dir,
        config=VerificationConfig(verification_ttl_seconds=ttl),
    )
    contract = verifier.build_contract(
        job_id=job_id,
        target="unity",
        command_type="unity.sync_assets",
        constraints={},
    )
    now = iso(datetime.now(timezone.utc))
    record = {
        "job_id": job_id,
        "command_id": f"cmd_{job_id}",
        "correlation_id": f"corr_{job_id}",
        "target": "unity",
        "command_type": "unity.sync_assets",
        "state": "accepted",
        "current_state": "accepted",
        "created_at": now,
        "updated_at": now,
        "state_entered_at": now,
        "dry_run": True,
        "artifact_contract": contract,
        "expected_artifact_contract_hash": verifier.contract_hash(contract),
        "artifacts": [],
    }
    claimed, _ = lease_manager.create_claimed(
        record,
        owner="worker:jules:test",
        worker_type="jules",
    )
    sm = JobStateMachine(job_id, initial_state="accepted", jobs_root=jobs_dir)
    for next_state in ("validating", "ready", "running"):
        sm.transition_to(
            next_state,
            owner=claimed["owner"],
            lease_id=claimed["lease_id"],
        )
    claimed = lease_manager.load(job_id)
    return lease_manager, verifier, claimed


def make_artifact(tmp_path: Path, job_id: str, name: str = "result.txt", content: bytes = b"ok\n") -> str:
    path = tmp_path / "artifacts" / "jobs" / job_id / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(content)
    return path.relative_to(tmp_path).as_posix()


def begin_valid_claim(tmp_path: Path, job_id: str = "verify-1", ttl: int = 120):
    lease_manager, verifier, record = setup_running_job(tmp_path, job_id=job_id, ttl=ttl)
    ref = make_artifact(tmp_path, job_id)
    claims = verifier.make_claims(job_id, [ref])
    verifying, event = verifier.begin_completion_claim(
        job_id,
        owner=record["owner"],
        lease_id=record["lease_id"],
        contract_hash=record["expected_artifact_contract_hash"],
        artifacts=claims,
        lease_manager=lease_manager,
    )
    assert event["type"] == "completion.claimed"
    assert verifying["current_state"] == "verifying"
    return lease_manager, verifier, record, ref, claims


def test_worker_cannot_self_promote_verifying_to_succeeded(tmp_path: Path) -> None:
    lease_manager, verifier, record, ref, claims = begin_valid_claim(tmp_path)
    sm = JobStateMachine("verify-1", jobs_root=lease_manager.jobs_dir)
    with pytest.raises(PermissionError, match="Only the artifact verifier"):
        sm.transition_to("succeeded", authority="worker")


def test_valid_artifact_claim_is_independently_verified(tmp_path: Path) -> None:
    _, verifier, _, _, claims = begin_valid_claim(tmp_path)
    final, events = verifier.verify_once("verify-1")
    assert final["current_state"] == "succeeded"
    assert final["verified_artifacts"] == claims
    assert final["verification_errors"] == []
    assert [event["type"] for event in events] == ["verification.succeeded", "job.succeeded"]


def test_missing_artifact_is_rejected(tmp_path: Path) -> None:
    lease_manager, verifier, record = setup_running_job(tmp_path, "missing")
    missing_ref = "artifacts/jobs/missing/does-not-exist.bin"
    verifying, _ = verifier.begin_completion_claim(
        "missing",
        owner=record["owner"],
        lease_id=record["lease_id"],
        contract_hash=record["expected_artifact_contract_hash"],
        artifacts=[{"path": missing_ref, "size_bytes": 123, "sha256": "0" * 64}],
        lease_manager=lease_manager,
    )
    assert verifying["current_state"] == "verifying"
    final, events = verifier.verify_once("missing")
    assert final["current_state"] == "verification_rejected"
    assert any(error.startswith("artifact_missing:") for error in final["verification_errors"])
    assert events[0]["type"] == "verification.rejected"


def test_tampered_artifact_after_completion_claim_is_rejected(tmp_path: Path) -> None:
    _, verifier, _, ref, _ = begin_valid_claim(tmp_path, "tampered")
    path = tmp_path / ref
    path.write_bytes(b"tampered after worker claim\n")
    final, _ = verifier.verify_once("tampered")
    assert final["current_state"] == "verification_rejected"
    assert any(
        error.startswith("artifact_size_mismatch:") or error.startswith("artifact_sha256_mismatch:")
        for error in final["verification_errors"]
    )


def test_same_size_tampering_is_detected_by_sha256(tmp_path: Path) -> None:
    _, verifier, _, ref, claims = begin_valid_claim(tmp_path, "same-size")
    path = tmp_path / ref
    original = path.read_bytes()
    replacement = b"X" * len(original)
    assert len(replacement) == len(original)
    path.write_bytes(replacement)
    final, _ = verifier.verify_once("same-size")
    assert final["current_state"] == "verification_rejected"
    assert any(error.startswith("artifact_sha256_mismatch:") for error in final["verification_errors"])


def test_claimed_contract_hash_must_match_claim_time_expectation(tmp_path: Path) -> None:
    lease_manager, verifier, record = setup_running_job(tmp_path, "contract-claim")
    ref = make_artifact(tmp_path, "contract-claim")
    claims = verifier.make_claims("contract-claim", [ref])
    verifier.begin_completion_claim(
        "contract-claim",
        owner=record["owner"],
        lease_id=record["lease_id"],
        contract_hash="f" * 64,
        artifacts=claims,
        lease_manager=lease_manager,
    )
    final, _ = verifier.verify_once("contract-claim")
    assert final["current_state"] == "verification_rejected"
    assert "claimed_contract_hash_mismatch" in final["verification_errors"]


def test_stored_contract_tampering_is_detected(tmp_path: Path) -> None:
    _, verifier, _, _, _ = begin_valid_claim(tmp_path, "contract-store")
    path = verifier.state_path("contract-store")
    record = json.loads(path.read_text(encoding="utf-8"))
    record["artifact_contract"]["min_artifacts"] = 99
    path.write_text(json.dumps(record, indent=2), encoding="utf-8")
    final, _ = verifier.verify_once("contract-store")
    assert final["current_state"] == "verification_rejected"
